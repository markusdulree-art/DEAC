[Version]
Signature="$WINDOWS NT$"
Class=System
ClassGuid={B1D1B7A4-5A95-46AA-ACAE-70D9A2CFDCE1}
Provider=%ManufacturerName%
DriverVer=08/20/2026,1.0.0.0
CatalogFile=deac_driver.cat

[DefaultInstall.NTamd64]
CopyFiles=DriverCopyFiles

[DefaultInstall.NTamd64.Services]
AddService=DEAC,0x00000002,ServiceInstall

[DestinationDirs]
DriverCopyFiles=12

[DriverCopyFiles]
deac_driver.sys

[ServiceInstall]
DisplayName=%ServiceName%
ServiceType=1
StartType=3
ErrorControl=1
ServiceBinary=%12%\\deac_driver.sys

[Strings]
ManufacturerName="DEAC"
ServiceName="DEAC Kernel Driver"
